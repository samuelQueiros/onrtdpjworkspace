ENVIRONMENT=production
SECRET_KEY=troque-por-uma-chave-longa-e-segura
CREDENTIALS_ENCRYPTION_KEY=troque-por-outra-chave-longa-e-segura-para-credenciais
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=true
ALLOW_INSECURE_PRODUCTION_COOKIE=false
# Lista de IPs ou redes CIDR de proxies confiaveis autorizados a enviar X-Forwarded-For.
TRUSTED_PROXY_IPS=172.16.0.0/12
POSTGRES_USER=ferias_app
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria-do-banco
POSTGRES_DB=ferias
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Use o IP ou dominio do servidor.
FRONTEND_URL=https://SEU_DOMINIO
VITE_DOCKER_API_URL=/api

FRONTEND_PORT=80
BACKEND_PORT=8000

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
UPLOAD_DIR=/app/uploads
