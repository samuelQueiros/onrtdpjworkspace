ENVIRONMENT=production
SECRET_KEY=troque-por-uma-chave-longa-e-segura
CREDENTIALS_ENCRYPTION_KEY=troque-por-outra-chave-longa-e-segura-para-credenciais
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=true
ALLOW_INSECURE_PRODUCTION_COOKIE=false
# Lista de IPs ou redes CIDR de proxies confiaveis autorizados a enviar X-Forwarded-For.
TRUSTED_PROXY_IPS=172.16.0.0/12

# Use o IP ou dominio do servidor.
FRONTEND_URL=http://SEU_DOMINIO_OU_IP
VITE_API_URL=/api

FRONTEND_PORT=80
BACKEND_PORT=8000

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sistema.com
