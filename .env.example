# ============================================================================
# ONRTDPJ Workspace — variáveis de ambiente para deploy via Docker Compose
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).
# ============================================================================

# ── Banco de dados (Postgres) ───────────────────────────────────────────────
POSTGRES_USER=ferias
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=ferias

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
ENVIRONMENT=production

# Obrigatorio. Gere com: python3 -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-segura

# Obrigatorio. Gere com o mesmo comando acima (use uma chave diferente da SECRET_KEY)
CREDENTIALS_ENCRYPTION_KEY=troque-por-outra-chave-longa-e-segura-para-credenciais

ACCESS_TOKEN_EXPIRE_MINUTES=480

# true somente quando o site for servido via HTTPS
COOKIE_SECURE=false

# URL publica usada pelos usuarios para acessar o frontend (usada no CORS).
# Precisa bater exatamente com o que aparece na barra de enderecos do navegador
# (o backend compara com o header Origin). Neste servidor, o hostname salvo em
# DNS/hosts para os usuarios e "chat-server" — inclua a porta se FRONTEND_PORT
# nao for 80 (ex.: http://chat-server:8081, quando outro projeto ja usa a 80/8080).
FRONTEND_URL=http://chat-server

# Opcional: lista de origens extras liberadas no CORS, separadas por virgula.
# Quando vazio, o backend usa apenas FRONTEND_URL.
# Exemplo: CORS_ORIGINS=https://app.dominio.com,https://admin.dominio.com
CORS_ORIGINS=

UPLOAD_DIR=/app/uploads

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# ── Frontend (Vite + Nginx) ──────────────────────────────────────────────────
# Caminho/URL que o navegador usa para falar com a API.
# Use "/api" (padrao) quando o Nginx do frontend faz proxy interno para o backend.
VITE_API_URL=/api

# ── Portas publicadas no host ───────────────────────────────────────────────
FRONTEND_PORT=80
BACKEND_PORT=8000
